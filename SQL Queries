-- Display all customers who live in 'Delhi'.
select customer_id, 
name from customers
where city = "Delhi";

-- Find the average rating of all restaurants in 'Mumbai'.
select avg(rating) 
from restaurants 
where city ="Mumbai";

-- List all customers who have placed at least one order.
select c.customer_id 
from customers c
where customer_id in (select customer_id from orders o);

																	-- OR --

select c.customer_id, c.name, 
count(distinct o.order_id) as no_of_orders
from customers c
left join orders o 
on o.customer_id = c.customer_id
where c.customer_id in 
(select customer_id from orders o)
group by c.customer_id, c.name;

-- Display the total number of orders placed by each customer.
select o.customer_id, c.name, count(order_id) 
from customers c
left join orders o 
on o.customer_id = c.customer_id
group by o.customer_id, c.name;

-- Find the total revenue generated by each restaurant.
select r.restaurant_id, r.name, 
coalesce(sum(o.total_amount),0) as total_revenue
from restaurants r
left join orders o 
on o.restaurant_id = r.restaurant_id
group by r.restaurant_id, r.name order by r.name asc;

-- Find the top 5 restaurants with the highest average rating.

select r.restaurant_id , r.name, avg(f.rating) as avg_rating 
from restaurants r
join orders o 
on r.restaurant_id = o.restaurant_id
join feedback f
on o.order_id =f.order_id
group by r.restaurant_id , r.name
order by avg_rating desc limit 5;

-- Display all customers who have never placed an order.
select c.customer_id, c.name 
from customers c
where customer_id not in 
(select customer_id from orders o);

-- Find the number of orders placed by each customer in 'Mumbai'.
select c.customer_id, c.name, c.city, 
count(o.order_id) as number_of_orders_placed 
from customers c
join orders o 
on c.customer_id = o.customer_id
where c.city = "Mumbai"
group by c.customer_id, c.name, c.city;

-- Display all orders placed in the last 30 days.
select order_id, date(order_date) 
from orders
where order_date >= date_sub((select max(order_date) from orders), 
interval 30 day);

-- List all delivery partners who have completed more than 1 delivery
select dp.partner_id, dp.name, COUNT(od.order_id) as total_deliveries
from deliverypartners dp
join orderdelivery od
on dp.partner_id = od.partner_id
group by dp.partner_id, dp.name
having COUNT(od.order_id) > 1 order by partner_id asc;

-- Find the customers who have placed orders on exactly three different days.
select o.customer_id, c.name, 
count(distinct order_date) as order_date_count
from orders o
join customers c
on o.customer_id = c.customer_id
group by customer_id
having order_date_count = 3;

-- Find the delivery partner who has worked with the most different customers.
select od.partner_id, dp.name, count(distinct c.customer_id) as no_of_diff_customers from orderdelivery od
join orders o
on od.order_id = o.order_id
join customers c
on o.customer_id = c.customer_id
join deliverypartners dp
on od.partner_id = dp.partner_id
group by od.partner_id, dp.name
order by no_of_diff_customers desc limit 1;

-- Identify customers who have the same city and have placed orders at the same restaurants, but on different dates.
select c1.customer_id, c1.name, c1.city, o1.restaurant_id, date(o1.order_date), 
c2.customer_id, c2.name, c2.city, o2.restaurant_id, date(o2.order_date)  from customers c1
join customers c2
on c1.city = c2.city 								-- same city
join orders o1
on c1.customer_id =o1.customer_id 
join orders o2
on c2.customer_id = o2.customer_id
and o1.restaurant_id = o2.restaurant_id  			-- same restaurant
and o1.order_date <> o2.order_date					-- different dates
and c1.customer_id < c2.customer_id;				-- non repeating customers

 
 
 
 
